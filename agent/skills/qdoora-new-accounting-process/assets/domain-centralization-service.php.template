<?php

namespace App\Services\Contabilidad;

use App\Models\Contabilidad\AccountingImputation;
use App\Models\User;

/**
 * Reglas de negocio de la centralización (contabilización) de {{DOMINIO}}.
 *
 * Responsabilidad acotada: decidir QUÉ cuenta recibe cada monto del documento.
 * Toda la mecánica genérica del asiento —construcción de la línea, inversión
 * por reversa, cuadratura y emisión del comprobante— vive en
 * AccountingEntryService.
 *
 * NO muta el documento: la vinculación del voucher y el cambio de estado
 * contable los realiza el servicio dueño ({{X}}Service), respetando la
 * propiedad del modelo.
 */
class {{X}}CentralizationService
{
    protected AccountingEntryService $accountingEntryService;
    protected AccountingImputationService $accountingImputationService;

    /**
     * Memo de la resolución de cuentas, vivo mientras dure la operación.
     * Ver references/account-resolution.md — sección "Eficiencia".
     *
     * @var array<string, mixed>
     */
    private array $resolutionCache = [];

    public function __construct(
        AccountingEntryService $accountingEntryService,
        AccountingImputationService $accountingImputationService
    ) {
        $this->accountingEntryService = $accountingEntryService;
        $this->accountingImputationService = $accountingImputationService;
    }

    /** Vacía el memo. Lo llaman las entradas de la centralización antes de empezar. */
    public function flushResolutionCache(): void
    {
        $this->resolutionCache = [];
    }

    /**
     * Resuelve las cuentas de cada monto del documento a partir de la spec.
     *
     * FUNCIÓN PURA: no escribe nada y no lanza excepciones. La consumen tanto
     * el dry-run del modal como la contabilización real.
     *
     * @return array{lines: array<int, array>, missing: array<int, array>}
     */
    public function resolverCuentas(array $spec): array
    {
        $lines = [];
        $missing = [];

        // ---- Un bloque por cada monto del documento ----
        // Mecanismo A: cuenta configurada en el tercero (imputación)
        $amount = round((float) $spec['amount_{{CONCEPTO}}'], 2);
        if ($amount > 0) {
            $config = $this->configFor($spec, '{{PURPOSE}}');

            // Una imputación marcada para revisión no puede contabilizarse: se
            // trata igual que una cuenta sin configurar.
            if (!$config || $config->needs_review) {
                $missing[] = $this->missingEntry('{{CONCEPTO}}', 'Cuenta de {{GLOSA}}', $amount, $config);
            } else {
                $lines[] = $this->accountingEntryService->buildLine($this->nodeFromConfig($config), [
                    'concept' => '{{CONCEPTO}}',
                    'label' => '{{GLOSA}}',
                    'side' => $spec['base_side'],
                    'amount' => $amount,
                    'auxiliary_id' => $config->auxiliary_id,
                    'cost_center_id' => $config->cost_center_id,
                ]);
            }
        }

        // Mecanismo B: cuenta maestra del plan (estructural, sin imputación)
        $amountTotal = round((float) $spec['amount_total'], 2);
        if ($amountTotal > 0) {
            $node = $this->remember(
                "master:{$spec['company_id']}:{$spec['master_third']}",
                fn () => $this->accountingEntryService->resolveMasterNode($spec['company_id'], $spec['master_third'])
            );

            if (!$node) {
                $missing[] = $this->missingEntry('tercero', 'Cuenta del {{TERCERO}}', $amountTotal);
            } else {
                $lines[] = $this->accountingEntryService->buildLine($node, [
                    'concept' => 'tercero',
                    'label' => '{{TERCERO}}',
                    'side' => $spec['third_side'],
                    'amount' => $amountTotal,
                    // La maestra no aporta auxiliar: lo pone el proceso.
                    'auxiliary_id' => $spec['third_id'],
                    // Línea candidata a cobro/pago en tesorería (solo esta).
                    'max_amount' => $amountTotal,
                ]);
            }
        }

        return ['lines' => $lines, 'missing' => $missing];
    }

    /**
     * Glosa en español de los conceptos que no pudieron resolverse, para el
     * mensaje de error de la centralización.
     */
    public function describeMissing(array $missing): string
    {
        return implode(', ', array_map(
            fn (array $entry) => $entry['reason']
                ? "{$entry['label']} ({$entry['reason']})"
                : $entry['label'],
            $missing
        ));
    }

    /**
     * Emite el comprobante delegando en el motor genérico.
     * Devuelve la llave del voucher (id + year). NO muta el documento.
     *
     * @return array{id: string, year: int}
     */
    public function crearComprobante(
        array $spec,
        array $lines,
        string $dateDMY,
        ?string $description,
        int $docId,
        string $numDoc,
        ?User $user
    ): array {
        return $this->accountingEntryService->postEntry(
            [
                'company_id' => $spec['company_id'],
                'date' => $dateDMY,
                'voucher_origin' => $spec['voucher_origin'],
                'voucher_type_code' => $spec['voucher_type_code'],
                'norma' => $spec['norma'],
                'currency' => 'CLP',
                'description' => $description,
                'document_id' => $docId,
                'document_number' => $numDoc,
                'is_note_credit' => false,
            ],
            $lines,
            $user
        );
    }

    // ===================================
    // PRIVADOS
    // ===================================

    /** Memoriza también el null: "no hay cuenta" es una respuesta válida. */
    private function remember(string $key, \Closure $resolver): mixed
    {
        if (!array_key_exists($key, $this->resolutionCache)) {
            $this->resolutionCache[$key] = $resolver();
        }

        return $this->resolutionCache[$key];
    }

    private function configFor(array $spec, string $purpose): ?AccountingImputation
    {
        return $this->remember(
            "cfg:{$spec['company_id']}:{$spec['third_id']}:{$purpose}",
            fn () => $this->accountingImputationService->resolve(/* owner */ ..., /* purpose */ ...)
        );
    }

    /** Nodo contable desde la imputación: subcuenta si existe, si no la cuenta. */
    private function nodeFromConfig(AccountingImputation $config): array
    {
        return $this->accountingEntryService->nodeFromModel($config->node());
    }

    /**
     * Concepto que no pudo resolverse. `configured` permite al modal
     * preseleccionar la cuenta vigente cuando quedó marcada para revisión.
     */
    private function missingEntry(
        string $concept,
        string $label,
        float $amount,
        ?AccountingImputation $config = null
    ): array {
        return [
            'concept' => $concept,
            'label' => $label,
            'amount' => $amount,
            'reason' => $config?->review_reason,
            'configured' => $this->configuredNode($config),
        ];
    }

    private function configuredNode(?AccountingImputation $config): ?array
    {
        $node = $config?->node();

        if (!$node) {
            return null;
        }

        return array_merge($this->accountingEntryService->nodeFromModel($node), [
            'auxiliary_id' => $config->auxiliary_id,
            'cost_center_id' => $config->cost_center_id,
        ]);
    }
}

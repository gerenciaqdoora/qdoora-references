/**
 * Plantilla: list.component.ts para catálogos/listados SIN paginación de backend
 * (app-table-without-pagination). Basado en el patrón real de CompanyTaxesListComponent.
 * Reemplaza {{Entity}} (PascalCase), {{entity}} (camelCase) y {{entities}} (plural).
 * NO agregues page/size/sort al Service — este patrón es 100% client-side.
 */
import { AsyncPipe, CommonModule } from '@angular/common';
import { ChangeDetectionStrategy, ChangeDetectorRef, Component, OnDestroy, OnInit } from '@angular/core';
import { fuseAnimations } from '@fuse/animations';
import { HeaderPremiumComponent } from 'app/modules/shared/header-premium/header-premium.component';
import { TableWithoutPaginationComponent, TableColumn } from 'app/modules/shared/table-without-pagination/table-without-pagination.component';
import { NotificationService } from 'app/core/services/notification.service';
import { Observable, Subject, takeUntil } from 'rxjs';
import { {{Entity}}Service } from '../{{entity}}.service';
import { {{Entity}} } from 'app/core/models/data/{{entity}}';

@Component({
    selector: '{{entity}}-list',
    standalone: true,
    templateUrl: './list.component.html',
    changeDetection: ChangeDetectionStrategy.OnPush,
    animations: fuseAnimations,
    imports: [
        CommonModule,
        AsyncPipe,
        HeaderPremiumComponent,
        TableWithoutPaginationComponent,
    ],
})
export class {{Entity}}ListComponent implements OnInit, OnDestroy {
    {{entities}}$: Observable<{{Entity}}[]>;
    isLoading = false;
    alertName = '{{entity}}List';

    columns: TableColumn[] = [
        // { key: 'name', label: 'Nombre', class: 'text-left', headerClass: 'text-left' },
        // { key: 'rate', label: 'Tasa', class: 'text-center font-semibold', headerClass: 'text-center', pipe: 'number' },
    ];

    private _unsubscribeAll = new Subject<void>();

    constructor(
        private _{{entity}}Service: {{Entity}}Service,
        private _notification: NotificationService,
        private _changeDetectorRef: ChangeDetectorRef,
    ) {}

    ngOnInit(): void {
        this.{{entities}}$ = this._{{entity}}Service.{{entities}}$;
        this.load();
    }

    ngOnDestroy(): void {
        this._unsubscribeAll.next();
        this._unsubscribeAll.complete();
    }

    load(): void {
        this.isLoading = true;
        this._{{entity}}Service
            .list()
            .pipe(takeUntil(this._unsubscribeAll))
            .subscribe({
                next: () => {
                    this.isLoading = false;
                    this._changeDetectorRef.markForCheck();
                },
                error: () => {
                    this.isLoading = false;
                    this._changeDetectorRef.markForCheck();
                    this._notification.error('No se pudo cargar el listado.');
                },
            });
    }
}

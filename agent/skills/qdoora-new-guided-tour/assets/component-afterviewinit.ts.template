// PLANTILLA — Disparo automático del tour en el componente de la vista
// Referencia canónica:
//   fuse-starter/src/app/modules/admin/general/users/create/create.component.ts
// =============================================================================

// --- 1. Import (junto al resto de imports de @angular/core) -------------------
import { AfterViewInit, inject } from '@angular/core';
import { TourManagerService } from 'app/core/tour/tour-manager.service';


// --- 2. Declaración de clase --------------------------------------------------
// Encadena AfterViewInit con los lifecycle hooks que ya implemente el componente.
export class <Nombre>Component implements OnInit, AfterViewInit, OnDestroy {

    // --- 3. Inyección (junto al resto de servicios inyectados) ----------------
    private _tourManagerService = inject(TourManagerService);


    // --- 4. Hook -------------------------------------------------------------
    ngAfterViewInit(): void {
        // Ejecutamos el tour con un pequeño retraso para asegurar que la vista esté completamente renderizada
        setTimeout(() => {
            this._tourManagerService.tryStartTour('<tour-key>');
        }, 500);
    }
}

// =============================================================================
// VARIANTE — Vista SIN resolver (data async en ngOnInit)

<!--
  Plantilla: layout de página de Configuración con ÁREAS FIJAS.
  Basada en el patrón real de billing/setting.component.html.
  Reemplaza {{Título}}, {{Subtítulo}}, {{ícono}} y el contenido de cada @if de área.
-->
<div class="bg-card flex min-w-0 flex-auto flex-col dark:bg-transparent sm:absolute sm:inset-0 sm:overflow-hidden">

    <!-- Header Premium -->
    <app-header-premium [title]="'{{Título de la Configuración}}'"
        [subtitle]="'{{Subtítulo breve del alcance}}'"
        [icon]="'heroicons_outline:cog-6-tooth'" [isLoading]="isLoading" [isSearchable]="false"
        [isAvailableButton]="false" [alertMessage]="alertName"></app-header-premium>

    <!-- Main Content -->
    <div class="flex flex-auto overflow-hidden">
        <mat-drawer-container class="h-full flex-auto bg-transparent" [hasBackdrop]="false">

            <!-- Área seleccionada (Izquierda) -->
            <mat-drawer-content class="flex flex-col overflow-y-auto">
                <div class="p-4 sm:p-6">
                    <div class="mx-auto flex w-full max-w-4xl flex-col gap-5">

                        <!-- ============================ ÁREA A ============================ -->
                        @if (activeSection === 'AREA_A') {
                            <section
                                class="bg-card flex flex-auto flex-col overflow-hidden rounded-2xl border border-gray-200 shadow-sm dark:border-gray-800">
                                <div
                                    class="flex items-center justify-between border-b bg-gray-50/30 p-4 px-6 dark:bg-gray-800/30">
                                    <div class="flex items-center gap-3">
                                        <div
                                            class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary-100 text-primary shadow-sm">
                                            <mat-icon class="icon-size-6" svgIcon="heroicons_outline:shield-check"></mat-icon>
                                        </div>
                                        <div>
                                            <h2 class="text-lg font-bold leading-none tracking-tight">Nombre Área A</h2>
                                            <p class="text-secondary mt-1.5 text-sm font-medium opacity-80">Descripción breve del área A.</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="flex flex-col p-5 sm:p-6">
                                    <!-- Contenido/formulario propio del área A -->
                                </div>
                            </section>
                        }

                        <!-- ============================ ÁREA B ============================ -->
                        @if (activeSection === 'AREA_B') {
                            <section
                                class="bg-card flex flex-auto flex-col overflow-hidden rounded-2xl border border-gray-200 shadow-sm dark:border-gray-800">
                                <div
                                    class="flex items-center justify-between border-b bg-gray-50/30 p-4 px-6 dark:bg-gray-800/30">
                                    <div class="flex items-center gap-3">
                                        <div
                                            class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 shadow-sm">
                                            <mat-icon class="icon-size-6" svgIcon="heroicons_outline:hashtag"></mat-icon>
                                        </div>
                                        <div>
                                            <h2 class="text-lg font-bold leading-none tracking-tight">Nombre Área B</h2>
                                            <p class="text-secondary mt-1.5 text-sm font-medium opacity-80">Descripción breve del área B.</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="flex flex-col p-5 sm:p-6">
                                    <!-- Contenido/formulario propio del área B -->
                                </div>
                            </section>
                        }

                    </div>
                </div>
            </mat-drawer-content>

            <!-- Sidebar de Áreas (Derecha — SIEMPRE position 'end') -->
            <mat-drawer class="w-72 border-r-0 bg-transparent" [mode]="'side'" [opened]="true" [position]="'end'">
                <div class="flex h-full flex-col p-6 pl-0 sm:p-8">
                    <div
                        class="bg-card flex flex-col overflow-hidden rounded-3xl border border-l-4 border-gray-200 border-l-blue-600 shadow-xl backdrop-blur-xl dark:border-gray-800">
                        <div class="p-6">
                            <div class="text-secondary mb-6 text-xs font-bold uppercase tracking-widest opacity-60">
                                Áreas
                            </div>

                            <div class="relative flex flex-col space-y-2">
                                @for (section of sections; track section.id) {
                                    <button mat-button
                                        class="group relative flex items-center justify-start rounded-xl px-4 py-3 transition-all duration-300"
                                        [ngClass]="{
                                            'bg-blue-50/50 text-blue-600 dark:bg-blue-900/10': activeSection === section.id,
                                            'text-secondary opacity-60 grayscale hover:bg-gray-100 hover:opacity-100 hover:grayscale-0 dark:hover:bg-gray-800': activeSection !== section.id
                                        }"
                                        (click)="setSection(section.id)">
                                        <mat-icon class="mr-4 transition-transform icon-size-5 group-hover:scale-110"
                                            [ngClass]="{ 'text-blue-600': activeSection === section.id }"
                                            [svgIcon]="section.icon"></mat-icon>
                                        <span class="text-sm font-bold tracking-tight">{{ section.label }}</span>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </mat-drawer>

        </mat-drawer-container>
    </div>
</div>

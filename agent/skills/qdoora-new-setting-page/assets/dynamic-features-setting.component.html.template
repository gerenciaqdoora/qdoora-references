<!--
  Plantilla: layout de página de Configuración con ÁREAS DINÁMICAS (registro de
  features toggleables). Basada en el patrón real de nomina/settings.component.html.
  El sidebar navega "categorías" derivadas de datos reales (availableCategories()),
  no un array fijo — si una categoría no tiene settings para la empresa, no aparece.
-->
<div class="flex min-w-0 flex-auto flex-col bg-[#F4F7FA] dark:bg-transparent sm:absolute sm:inset-0 sm:overflow-hidden">

    <app-header-premium
        [title]="'Configuraciones de {{Entity}}'"
        [subtitle]="'Parámetros configurables del módulo'"
        [icon]="'heroicons_outline:cog-6-tooth'"
        [isLoading]="isLoading"
        [isSearchable]="false"
        [isAvailableButton]="false"
        [alertMessage]="alertName">
    </app-header-premium>

    <div class="flex flex-auto overflow-hidden">
        <mat-drawer-container class="h-full flex-auto bg-transparent" [hasBackdrop]="false">

            <mat-drawer-content class="flex flex-col overflow-y-auto">
                <div class="p-4 sm:p-6">
                    <div class="mx-auto grid w-full max-w-5xl grid-cols-1 gap-5">
                        @for (setting of filteredSettings(); track setting.feature_key) {
                            <div class="bg-card flex flex-auto flex-col overflow-hidden rounded-2xl border border-gray-200 shadow-md dark:border-gray-800">
                                <div class="flex items-center justify-between border-b bg-gray-50/30 p-4 px-6 dark:bg-gray-800/30 sm:py-4">
                                    <div class="flex items-center">
                                        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary-100 text-primary shadow-sm">
                                            <mat-icon class="icon-size-6" svgIcon="heroicons_outline:cog"></mat-icon>
                                        </div>
                                        <div class="ml-5">
                                            <div class="flex items-center">
                                                <h2 class="text-lg font-bold leading-none tracking-tight">{{ setting.label }}</h2>
                                                @if (setting.is_mandatory) {
                                                    <span class="ml-2.5 rounded-full bg-blue-500 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-white shadow-sm">
                                                        Obligatorio
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Gotcha: features is_mandatory NO muestran el toggle -->
                                    @if (!setting.is_mandatory) {
                                        <mat-slide-toggle [checked]="setting.is_active" color="primary"
                                            (change)="onToggle(setting, $event.checked)">
                                        </mat-slide-toggle>
                                    }
                                </div>

                                @if (setting.is_active || setting.is_mandatory) {
                                    <div class="flex flex-col p-5 sm:p-6">
                                        <form [formGroup]="forms[setting.feature_key]">
                                            <div class="min-h-24">
                                                <!-- @switch (setting.feature_key) { @case ('X') { <app-x-config [form]="forms[setting.feature_key]"></app-x-config> } } -->
                                            </div>

                                            <div class="mt-4 flex items-center justify-end border-t border-dashed pt-4">
                                                <button mat-flat-button color="primary"
                                                    [disabled]="saving[setting.feature_key] || forms[setting.feature_key].pristine"
                                                    (click)="onSaveConfig(setting.feature_key)">
                                                    {{ saving[setting.feature_key] ? 'Guardando...' : 'Guardar Cambios' }}
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </mat-drawer-content>

            <!-- Sidebar de Categorías (Derecha — SIEMPRE position 'end') -->
            <mat-drawer class="w-72 border-r-0 bg-transparent" [mode]="'side'" [opened]="true" [position]="'end'">
                <div class="flex h-full flex-col p-6 pl-0 sm:p-8">
                    <div class="bg-card flex flex-col overflow-hidden rounded-3xl border border-l-4 border-gray-200 border-l-blue-600 shadow-xl backdrop-blur-xl dark:border-gray-800">
                        <div class="p-6">
                            <div class="text-secondary mb-6 text-xs font-bold uppercase tracking-widest opacity-60">
                                Categorías
                            </div>
                            <div class="relative flex flex-col space-y-2">
                                @for (category of availableCategories(); track category.id) {
                                    <button mat-button
                                        class="group relative flex items-center justify-start rounded-xl px-4 py-3 transition-all duration-300"
                                        [ngClass]="{
                                            'bg-blue-50/50 text-blue-600 dark:bg-blue-900/10': activeCategory() === category.id,
                                            'text-secondary opacity-60 grayscale hover:bg-gray-100 hover:opacity-100 hover:grayscale-0 dark:hover:bg-gray-800': activeCategory() !== category.id
                                        }"
                                        (click)="setCategory(category.id)">
                                        <mat-icon class="mr-4 transition-transform icon-size-5 group-hover:scale-110"
                                            [ngClass]="{ 'text-blue-600': activeCategory() === category.id }"
                                            [svgIcon]="category.icon"></mat-icon>
                                        <span class="text-sm font-bold tracking-tight">{{ category.label }}</span>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </mat-drawer>

        </mat-drawer-container>
    </div>
</div>
